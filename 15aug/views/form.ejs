<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Add New User</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            min-height: 100vh;
            background:
                radial-gradient(circle at top left, #fff8f2, transparent 35%),
                linear-gradient(135deg, #f7f1ec, #e8ddd5);
            color: #3e2723;
        }

        /* ================= NAVBAR ================= */

        .navbar {
            background: rgba(78, 52, 46, 0.97);
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            color: white;
            box-shadow: 0 5px 20px rgba(78, 52, 46, 0.25);
        }

        .logo {
            font-size: 22px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .logo span {
            color: #d7b899;
        }

        .back-home {
            text-decoration: none;
            color: white;
            background: rgba(255, 255, 255, 0.12);
            padding: 10px 18px;
            border-radius: 10px;
            transition: 0.3s;
            font-size: 14px;
        }

        .back-home:hover {
            background: rgba(255, 255, 255, 0.22);
            transform: translateX(-3px);
        }

        /* ================= MAIN ================= */

        .page-container {
            min-height: calc(100vh - 70px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 50px 20px;
        }

        /* ================= FORM CARD ================= */

        .form-card {
            width: 100%;
            max-width: 600px;
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(15px);
            border-radius: 28px;
            padding: 45px;
            box-shadow: 0 20px 50px rgba(78, 52, 46, 0.15);
            border: 1px solid rgba(111, 78, 55, 0.1);
            position: relative;
            overflow: hidden;
        }

        .form-card::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(139, 94, 60, 0.08);
            top: -80px;
            right: -70px;
        }

        .form-card::after {
            content: "";
            position: absolute;
            width: 120px;
            height: 120px;
            border-radius: 50%;
            background: rgba(111, 78, 55, 0.06);
            bottom: -50px;
            left: -40px;
        }

        .form-content {
            position: relative;
            z-index: 2;
        }

        /* ================= FORM HEADER ================= */

        .form-icon {
            width: 70px;
            height: 70px;
            margin: auto;
            margin-bottom: 20px;

            display: flex;
            align-items: center;
            justify-content: center;

            border-radius: 22px;

            background:
                linear-gradient(135deg, #9c7054, #5d3a29);

            color: white;
            font-size: 32px;

            box-shadow:
                0 10px 25px rgba(93, 58, 41, 0.25);
        }

        .form-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .form-header h1 {
            font-size: 34px;
            color: #4e342e;
            margin-bottom: 10px;
        }

        .form-header p {
            color: #8d6e63;
            font-size: 15px;
        }

        /* ================= FORM INPUTS ================= */

        .form-group {
            margin-bottom: 22px;
        }

        label {
            display: block;
            margin-bottom: 9px;
            font-weight: bold;
            font-size: 14px;
            color: #5d4037;
        }

        .input-wrapper {
            position: relative;
        }

        .input-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 17px;
        }

        input,
        select {
            width: 100%;
            padding: 15px 15px 15px 48px;

            border: 1px solid #ddcfc7;
            border-radius: 14px;

            background: #fffaf7;
            color: #4e342e;

            font-size: 15px;
            outline: none;

            transition: 0.3s;
        }

        select {
            padding-left: 48px;
            cursor: pointer;
        }

        input:focus,
        select:focus {
            border-color: #8b5e3c;
            background: white;

            box-shadow:
                0 0 0 4px rgba(139, 94, 60, 0.1);
        }

        input::placeholder {
            color: #bca99f;
        }

        /* ================= BUTTON ================= */

        .submit-btn {
            width: 100%;
            padding: 16px;

            border: none;
            border-radius: 14px;

            background:
                linear-gradient(135deg, #8b5e3c, #5d3a29);

            color: white;

            font-size: 16px;
            font-weight: bold;

            cursor: pointer;

            margin-top: 8px;

            box-shadow:
                0 10px 25px rgba(93, 58, 41, 0.25);

            transition: 0.3s;
        }

        .submit-btn:hover {
            transform: translateY(-3px);
            box-shadow:
                0 15px 30px rgba(93, 58, 41, 0.35);
        }

        .submit-btn:active {
            transform: scale(0.98);
        }

        /* ================= FOOTER ================= */

        .form-footer {
            text-align: center;
            margin-top: 25px;
            color: #8d6e63;
            font-size: 14px;
        }

        .form-footer a {
            color: #6f4e37;
            text-decoration: none;
            font-weight: bold;
        }

        .form-footer a:hover {
            color: #3e2723;
            text-decoration: underline;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 600px) {

            .navbar {
                padding: 15px 20px;
            }

            .logo {
                font-size: 18px;
            }

            .back-home {
                padding: 8px 12px;
                font-size: 12px;
            }

            .page-container {
                padding: 30px 15px;
            }

            .form-card {
                padding: 30px 22px;
            }

            .form-header h1 {
                font-size: 28px;
            }

        }
    </style>

</head>


<body>

    <!-- NAVBAR -->

    <nav class="navbar">

        <div class="logo">
            ☕ Brew<span>Users</span>
        </div>

        <a href="/getdata" class="back-home">
            ← Back to Users
        </a>

    </nav>


    <!-- MAIN -->

    <div class="page-container">

        <div class="form-card">

            <div class="form-content">


                <!-- FORM HEADER -->

                <div class="form-icon">
                    👤
                </div>


                <div class="form-header">

                    <h1>Add New User</h1>

                    <p>
                        Create a new profile for your community
                    </p>

                </div>


                <!-- FORM -->

                <form action="/adduser" method="POST">


                    <!-- FIRST NAME -->

                    <div class="form-group">

                        <label for="first_name">
                            First Name
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                👤
                            </span>

                            <input
                                type="text"
                                id="first_name"
                                name="first_name"
                                placeholder="Enter first name"
                                required
                            >

                        </div>

                    </div>


                    <!-- LAST NAME -->

                    <div class="form-group">

                        <label for="last_name">
                            Last Name
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                👥
                            </span>

                            <input
                                type="text"
                                id="last_name"
                                name="last_name"
                                placeholder="Enter last name"
                                required
                            >

                        </div>

                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label for="email">
                            Email Address
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ✉️
                            </span>

                            <input
                                type="email"
                                id="email"
                                name="email"
                                placeholder="Enter email address"
                                required
                            >

                        </div>

                    </div>


                    <!-- GENDER -->

                    <div class="form-group">

                        <label for="gender">
                            Gender
                        </label>

                        <div class="input-wrapper">

                            <span class="input-icon">
                                ⚧
                            </span>

                            <select
                                id="gender"
                                name="gender"
                                required
                            >

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                        </div>

                    </div>


                    <!-- SUBMIT -->

                    <button
                        type="submit"
                        class="submit-btn"
                    >
                        ＋ Add User
                    </button>


                </form>


                <!-- FOOTER -->

                <div class="form-footer">

                    Want to see all users?

                    <a href="/getdata">
                        View User List →
                    </a>

                </div>


            </div>

        </div>

    </div>

</body>

</html>