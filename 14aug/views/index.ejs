<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Nova | Welcome</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            min-height: 100vh;
            color: white;
            background: #070b18;
            overflow-x: hidden;
        }

        /* ================= BACKGROUND ================= */

        .background {
            position: fixed;
            inset: 0;
            overflow: hidden;
            z-index: -1;
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            filter: blur(90px);
            opacity: 0.5;
            animation: float 8s infinite alternate ease-in-out;
        }

        .blob1 {
            width: 400px;
            height: 400px;
            background: #6c63ff;
            top: -150px;
            left: -100px;
        }

        .blob2 {
            width: 350px;
            height: 350px;
            background: #ff4ecd;
            right: -100px;
            top: 200px;
            animation-delay: 2s;
        }

        .blob3 {
            width: 300px;
            height: 300px;
            background: #00d9ff;
            bottom: -150px;
            left: 35%;
            animation-delay: 4s;
        }

        @keyframes float {
            from {
                transform: translate(0, 0) scale(1);
            }

            to {
                transform: translate(50px, 30px) scale(1.15);
            }
        }

        /* ================= NAVBAR ================= */

        nav {
            width: 90%;
            max-width: 1200px;
            height: 70px;

            margin: 20px auto;

            padding: 0 25px;

            display: flex;
            justify-content: space-between;
            align-items: center;

            border: 1px solid rgba(255, 255, 255, 0.15);

            background: rgba(255, 255, 255, 0.08);

            backdrop-filter: blur(20px);

            border-radius: 20px;
        }

        .logo {
            font-size: 25px;
            font-weight: bold;
            letter-spacing: 1px;
        }

        .logo span {
            color: #8c7cff;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 30px;
        }

        nav a {
            color: #ddd;
            text-decoration: none;
            transition: 0.3s;
        }

        nav a:hover {
            color: white;
        }

        .nav-btn {
            padding: 10px 18px;
            border-radius: 10px;
            background: #ffffff;
            color: #111 !important;
            font-weight: bold;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 600px;

            display: flex;
            justify-content: center;
            align-items: center;

            text-align: center;

            padding: 70px 20px;
        }

        .hero-content {
            max-width: 900px;
        }

        .badge {
            display: inline-block;

            padding: 8px 16px;

            border: 1px solid rgba(255,255,255,0.2);

            background: rgba(255,255,255,0.08);

            border-radius: 30px;

            font-size: 14px;

            margin-bottom: 25px;

            animation: fadeUp 1s ease;
        }

        .hero h1 {
            font-size: clamp(50px, 8vw, 90px);

            line-height: 1;

            margin-bottom: 25px;

            letter-spacing: -4px;

            animation: fadeUp 1.2s ease;
        }

        .gradient-text {
            background: linear-gradient(
                90deg,
                #8c7cff,
                #ff5bd6,
                #00d9ff
            );

            -webkit-background-clip: text;

            color: transparent;
        }

        .hero p {
            max-width: 650px;

            margin: auto;

            color: #aaa;

            font-size: 18px;

            line-height: 1.7;

            margin-bottom: 35px;

            animation: fadeUp 1.4s ease;
        }

        /* ================= BUTTONS ================= */

        .buttons {
            display: flex;

            justify-content: center;

            gap: 15px;

            flex-wrap: wrap;
        }

        .btn {
            padding: 15px 28px;

            border-radius: 12px;

            text-decoration: none;

            font-weight: bold;

            transition: 0.3s;
        }

        .primary {
            color: white;

            background: linear-gradient(
                135deg,
                #7567ff,
                #b34cff
            );

            box-shadow:
                0 10px 30px rgba(117, 103, 255, 0.3);
        }

        .secondary {
            color: white;

            border: 1px solid rgba(255,255,255,0.2);

            background: rgba(255,255,255,0.05);

            backdrop-filter: blur(10px);
        }

        .btn:hover {
            transform: translateY(-4px);
        }

        /* ================= STATS ================= */

        .stats {
            display: flex;

            justify-content: center;

            gap: 70px;

            margin-top: 60px;

            flex-wrap: wrap;
        }

        .stat h2 {
            font-size: 30px;
        }

        .stat p {
            color: #888;
            font-size: 13px;
            margin-top: 5px;
        }

        /* ================= FEATURES ================= */

        .features {
            width: 90%;

            max-width: 1100px;

            margin: 50px auto 100px;

            display: grid;

            grid-template-columns:
                repeat(auto-fit, minmax(220px, 1fr));

            gap: 20px;
        }

        .card {
            padding: 30px;

            border-radius: 20px;

            border: 1px solid rgba(255,255,255,0.12);

            background: rgba(255,255,255,0.06);

            backdrop-filter: blur(15px);

            transition: 0.4s;
        }

        .card:hover {
            transform: translateY(-10px);

            border-color: rgba(140,124,255,0.6);

            background: rgba(255,255,255,0.1);
        }

        .icon {
            width: 50px;
            height: 50px;

            display: flex;

            align-items: center;
            justify-content: center;

            border-radius: 14px;

            background: rgba(140,124,255,0.15);

            font-size: 24px;

            margin-bottom: 20px;
        }

        .card h3 {
            margin-bottom: 10px;
        }

        .card p {
            color: #999;

            line-height: 1.6;

            font-size: 14px;
        }

        /* ================= FOOTER ================= */

        footer {
            text-align: center;

            padding: 30px;

            color: #666;

            border-top: 1px solid rgba(255,255,255,0.08);
        }

        /* ================= ANIMATION ================= */

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* ================= MOBILE ================= */

        @media (max-width: 700px) {

            nav {
                width: 94%;
            }

            nav ul {
                gap: 12px;
            }

            nav ul li:nth-child(1) {
                display: none;
            }

            .hero {
                padding-top: 50px;
            }

            .hero h1 {
                letter-spacing: -2px;
            }

            .stats {
                gap: 30px;
            }
        }
    </style>
</head>

<body>

    <!-- Background -->
    <div class="background">
        <div class="blob blob1"></div>
        <div class="blob blob2"></div>
        <div class="blob blob3"></div>
    </div>


    <!-- Navbar -->

    <nav>

        <div class="logo">
            NOVA<span>.</span>
        </div>

        <ul>

            <li>
                <a href="/">Home</a>
            </li>

            <li>
                <a href="#features">Features</a>
            </li>

            <li>
                <a href="/form" class="nav-btn">
                    Join Us
                </a>
            </li>

        </ul>

    </nav>


    <!-- Hero -->

    <section class="hero">

        <div class="hero-content">

            <div class="badge">
                ✨ Welcome to something new
            </div>

            <h1>
                Build.
                <span class="gradient-text">
                    Create.
                </span>
                <br>
                Experience.
            </h1>

            <p>
                A modern web experience built with
                Node.js, Express and EJS.
                Start your journey and become part of
                something amazing.
            </p>


            <div class="buttons">

                <a href="/form" class="btn primary">
                    Get Started →
                </a>

                <a href="#features" class="btn secondary">
                    Explore Features
                </a>

            </div>


            <!-- Stats -->

            <div class="stats">

                <div class="stat">
                    <h2>100+</h2>
                    <p>Users</p>
                </div>

                <div class="stat">
                    <h2>24/7</h2>
                    <p>Available</p>
                </div>

                <div class="stat">
                    <h2>99%</h2>
                    <p>Satisfaction</p>
                </div>

            </div>

        </div>

    </section>


    <!-- Features -->

    <section class="features" id="features">

        <div class="card">

            <div class="icon">
                ⚡
            </div>

            <h3>
                Lightning Fast
            </h3>

            <p>
                Experience a fast and responsive
                application designed for modern users.
            </p>

        </div>


        <div class="card">

            <div class="icon">
                🔒
            </div>

            <h3>
                Secure
            </h3>

            <p>
                Your data is handled carefully with
                secure server-side processing.
            </p>

        </div>


        <div class="card">

            <div class="icon">
                🚀
            </div>

            <h3>
                Easy to Use
            </h3>

            <p>
                Simple interfaces designed to help
                you get started without complexity.
            </p>

        </div>


        <div class="card">

            <div class="icon">
                💡
            </div>

            <h3>
                Innovative
            </h3>

            <p>
                Built with modern technologies and
                a focus on an amazing user experience.
            </p>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        © 2026 NOVA. Built with Node.js + Express + EJS.

    </footer>

</body>
</html>