<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Register | AuthSphere</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: "Poppins", sans-serif;
        }

        body {
            min-height: 100vh;
            display: grid;
            place-items: center;
            padding: 30px;

            background:
                radial-gradient(circle at 15% 20%, #ff4ecd, transparent 30%),
                radial-gradient(circle at 85% 80%, #00d4ff, transparent 35%),
                #090b19;

            color: white;
        }

        .container {
            width: min(95%, 480px);
            position: relative;

            padding: 40px;

            border-radius: 30px;

            background: rgba(255,255,255,.08);

            border: 1px solid rgba(255,255,255,.2);

            backdrop-filter: blur(25px);

            box-shadow:
                25px 25px 60px rgba(0,0,0,.45),
                -10px -10px 30px rgba(255,255,255,.03);

            transform: perspective(1200px) rotateY(-2deg);
            transition: .4s;
        }

        .container:hover {
            transform: perspective(1200px) rotateY(0deg) translateY(-5px);
        }

        .back {
            color: #b7f5ff;
            text-decoration: none;
            font-size: 14px;
        }

        h2 {
            margin-top: 20px;
            font-size: 34px;
        }

        .subtitle {
            color: #afb5ca;
            margin: 8px 0 25px;
        }

        .input-group {
            margin-bottom: 17px;
        }

        label {
            display: block;
            margin-bottom: 7px;
            font-size: 14px;
            color: #d8dced;
        }

        input,
        select {
            width: 100%;
            padding: 14px;

            border-radius: 14px;

            border: 1px solid rgba(255,255,255,.15);

            background: rgba(255,255,255,.07);

            color: white;

            outline: none;

            transition: .3s;
        }

        select option {
            background: #151a31;
            color: white;
        }

        input:focus,
        select:focus {
            border-color: #00d4ff;
            box-shadow: 0 0 20px rgba(0,212,255,.2);
            transform: translateY(-2px);
        }

        input::placeholder {
            color: #858ca5;
        }

        button {
            width: 100%;

            margin-top: 8px;

            padding: 15px;

            border: none;
            border-radius: 14px;

            cursor: pointer;

            color: white;

            font-size: 16px;
            font-weight: 600;

            background: linear-gradient(
                135deg,
                #ff4ecd,
                #6d5dfc,
                #00c6ff
            );

            background-size: 200%;

            transition: .4s;

            box-shadow: 0 15px 35px rgba(109,93,252,.25);
        }

        button:hover {
            background-position: right;
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(0,198,255,.3);
        }

        .bottom-text {
            margin-top: 22px;
            text-align: center;
            color: #afb5ca;
            font-size: 14px;
        }

        .bottom-text a {
            color: #00d4ff;
            font-weight: 600;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="container">

        <a href="/" class="back">← Back to Home</a>

        <h2>Create Account ✨</h2>

        <p class="subtitle">
            Join the secure AuthSphere experience.
        </p>

        <form action="/register" method="POST">

            <div class="input-group">

                <label>Full Name</label>

                <input
                    type="text"
                    name="name"
                    placeholder="Enter your name"
                    required
                >

            </div>

            <div class="input-group">

                <label>Email Address</label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter your email"
                    required
                >

            </div>

            <div class="input-group">

                <label>Password</label>

                <input
                    type="password"
                    name="password"
                    placeholder="Create a strong password"
                    required
                >

            </div>

            <div class="input-group">

                <label>Select Role</label>

                <select name="role">

                    <option value="student">
                        Student
                    </option>

                    <option value="faculty">
                        Faculty
                    </option>

                </select>

            </div>

            <button type="submit">
                Create My Account →
            </button>

        </form>

        <p class="bottom-text">

            Already have an account?

            <a href="/login">
                Login here
            </a>

        </p>

    </div>

</body>
</html>